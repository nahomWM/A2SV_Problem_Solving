class Solution:
    def findRadius(self, houses: List[int], heaters: List[int]) -> int:
        houses.sort()
        heaters.sort() 
        a = 0
        sol = 0 
        for i in houses:
            while a < len(heaters) - 1 and abs(heaters[a+1] - i) <= abs(heaters[a] - i):
                a += 1    
            sol = max(sol, abs(heaters[a] - i))
        return sol
