class Solution:
    def minEatingSpeed(self, piles: List[int], h: int) -> int:
        l = 1
        r = max(piles)
        while l < r:
            mid = (l + r) // 2
            hours = 0
            for pile in piles:
                if pile % mid == 0:
                    hours = hours + (pile // mid)
                else:
                    hours = hours + (pile // mid) + 1
            if hours <= h:
                r = mid
            else:
                l = mid + 1
        return l
