class Solution:
    def maxWidthOfVerticalArea(self, points: list[list[int]]) -> int:
        a = []
        for p in points:
            a.append(p[0])
        a.sort()
        sol = 0
        for i in range(1, len(a)):
            if a[i] - a[i-1] > sol:
                sol = a[i] - a[i-1]
        return sol
