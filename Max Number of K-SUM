class Solution:
    def maxOperations(self, n, k):
        d = {}
        c = 0  
        for x in n:
            y = k - x
            if y in d and d[y] > 0:
                c += 1
                d[y] -= 1
            else:
                if x not in d:
                    d[x] = 0
                d[x] += 1   
        return c
