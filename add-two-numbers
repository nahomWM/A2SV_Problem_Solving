# class ListNode(object):
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next

class Solution(object):
    def addTwoNumbers(self, l1, l2):
        def list_to_string(node):
            digits = []
            while node:
                digits.append(str(node.val))
                node = node.next
            return ''.join(digits[::-1])
        num1 = int(list_to_string(l1))
        num2 = int(list_to_string(l2))
        total = num1 + num2

        total_str = str(total)[::-1] 
        dummy = ListNode(0)
        current = dummy
        for ch in total_str:
            current.next = ListNode(int(ch))
            current = current.next
        
        return dummy.next
