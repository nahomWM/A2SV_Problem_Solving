class Solution(object):
    def predictTheWinner(self, nums):
        def mainfun(i, j):
            if i == j:
                return nums[i]

            a = nums[i] - mainfun(i+1, j)
            b = nums[j] - mainfun(i, j-1)
            
            return max(a,b)
        return mainfun(0, len(nums)-1) >= 0
