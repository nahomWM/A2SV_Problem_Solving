class Solution(object):
    def merge(self, intervals):
        if not intervals:
            return []
        intervals.sort()
        m = []
        m.append(intervals[0])
        for i in range(1, len(intervals)):
            last = m[-1]
            current = intervals[i]
            if current[0] <= last[1]:
                last[1] = max(last[1], current[1])
            else:
                m.append(current)

        return m
