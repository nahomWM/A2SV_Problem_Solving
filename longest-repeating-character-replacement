class Solution:
    def characterReplacement(self, s: str, k: int) -> int:
        l = 0
        count = {}
        sol = 0
        for a in range(len(s)):
            count[s[a]] = count.get(s[a], 0) + 1
            while (a - l + 1) - max(count.values()) > k:
                count[s[l]] -= 1
                l += 1
            sol = max(sol, a - l + 1)
        return sol
