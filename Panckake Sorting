class Solution:
    def pancakeSort(self, arr):
        sol = []
        
        for a in range(len(arr), 1, -1):
            i = arr.index(max(arr[:a]))   
            if i != a - 1:
                if i != 0:
                    arr[:i+1] = arr[:i+1][::-1]
                    sol.append(i+1)     
                arr[:a] = arr[:a][::-1]
                sol.append(a)  
        return sol
