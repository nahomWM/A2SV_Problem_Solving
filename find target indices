class Solution(object):
    def targetIndices(self, nums, target):
        n = len(nums)
        for i in range(n - 1):
            swapped = False
            for j in range(n - i - 1):
                if nums[j] > nums[j + 1]:
                    nums[j], nums[j + 1] = nums[j + 1], nums[j]
                    swapped = True
            if not swapped:
                break
        result = []
        for i in range(n):
            if nums[i] == target:
                result.append(i)

        return result
