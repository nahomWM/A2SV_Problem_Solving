class Solution:
    def totalFruit(self, fruits):
        a = b = -1
        c = 0
        i = 0
        j = 0
        sol = 0
        for x in fruits:
            if x == a or x == b:
                j += 1
            else:
                j = c + 1
            if x == a:
                c += 1
            else:
                c = 1
                b = a
                a = x

            sol = max(sol, j)
        return sol
