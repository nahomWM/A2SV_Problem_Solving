class Solution:
    def evalRPN(self, tokens):
        stack = []

        for i in tokens:
            if i in "+-*/":
                b = stack.pop()
                a = stack.pop()
                if i == "+":
                    stack.append(a + b)
                elif i == "-":
                    stack.append(a - b)
                elif i == "*":
                    stack.append(a * b)
                else:
                    if a * b < 0 and a % b != 0:
                        stack.append(a // b + 1)
                    else:
                        stack.append(a // b)
            else:
                stack.append(int(i))

        return stack[0]
