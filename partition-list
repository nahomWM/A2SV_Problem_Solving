# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next
class Solution:
    def partition(self, head: Optional[ListNode], x: int) -> Optional[ListNode]:
        vals = []
        while head:
            vals.append(head.val)
            head = head.next 
        less = []
        greater = []  
        for v in vals:
            if v < x:
                less.append(v)
            else:
                greater.append(v) 
        vals = less + greater 
        dummy = ListNode(0)
        cur = dummy
        for v in vals:
            cur.next = ListNode(v)
            cur = cur.next 
        return dummy.next
