class Solution:
    def maxArea(self, height: list[int]) -> int:
        i = 0
        j = len(height) - 1
        sol = 0
        last_moved = None
        while i < j:
            area = min(height[i], height[j]) * (j - i)
            if area > sol:
                sol = area
            if height[i] < height[j]:
                last_moved = 'i'
                i += 1
            else:
                last_moved = 'j'
                j -= 1
        return sol
