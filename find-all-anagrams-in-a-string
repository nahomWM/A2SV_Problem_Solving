from collections import Counter

class Solution(object):
    def findAnagrams(self, s, p):
        sol = []
        pc = Counter(p)
        w = Counter()  
        k = len(p)

        for i in range(len(s)):
            w[s[i]] += 1

            if i >= k:
                if w[s[i-k]] == 1:
                    del w[s[i-k]]
                else:
                    w[s[i-k]] -= 1

            if w == pc:
                sol.append(i - k + 1)
        return sol
