solution url: https://leetcode.com/problems/find-first-and-last-position-of-element-in-sorted-array/submissions/1985576700/

class Solution:
    def searchRange(self, nums, target):
        l = bisect.bisect_left(nums, target)
        r = bisect.bisect_right(nums, target) - 1 
        if l <= r:
            return [l, r]
        return [-1, -1]
        
