n, m = map(int, input().split())
a = list(map(int, input().split()))
b = list(map(int, input().split()))
i = 0
j = 0
sol = []
while i < n and j < m:
    if a[i] <= b[j]:
        sol.append(a[i])
        i += 1
    else:
        sol.append(b[j])
        j += 1
while i < n:
    sol.append(a[i])
    i += 1
while j < m:
    sol.append(b[j])
    j += 1
print(*sol)
