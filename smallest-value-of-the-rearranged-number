class Solution(object):
    def smallestNumber(self, num):
        if num >= 0:
            digits = list(str(num))
            digits.sort()
            if digits[0] == '0':
                for i in range(1, len(digits)):
                    if digits[i] != '0':
                        digits[0], digits[i] = digits[i], digits[0]
                        break
            result = 0
            for d in digits:
                result = result * 10 + int(d)
            return result 
        else:
            digits = list(str(-num)) 
            digits.sort(reverse=True)
            
            result = 0
            for d in digits:
                result = result * 10 + int(d)
            return -result
