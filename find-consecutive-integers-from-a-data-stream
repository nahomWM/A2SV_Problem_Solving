class DataStream:

    def __init__(self, value: int, k: int):
        self.value = value
        self.k = k
        self.sol = 0  
    def consec(self, num: int) -> bool:
        if num == self.value:
            self.sol += 1
        else:
            self.sol = 0
        if self.sol >= self.k:
            return True
        return False

