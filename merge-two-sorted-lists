# Definition for singly-linked list.
# class ListNode:
#     def __init__(self, val=0, next=None):
#         self.val = val
#         self.next = next

class Solution:
    def mergeTwoLists(self, list1, list2):
        merged_values = []
        while list1:
            merged_values.append(list1.val)
            list1 = list1.next
        while list2:
            merged_values.append(list2.val)
            list2 = list2.next
        merged_values.sort()
        dummy = current = ListNode(0)
        for val in merged_values:
            current.next = ListNode(val)
            current = current.next

        return dummy.next
