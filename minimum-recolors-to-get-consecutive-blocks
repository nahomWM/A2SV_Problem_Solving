class Solution:
    def minimumRecolors(self, blocks: str, k: int) -> int:
        a = 0
        sol = len(blocks)
        for i in range(len(blocks)):
            if blocks[i] == 'W':
                a += 1
            if i >= k:
                if blocks[i - k] == 'W':
                    a -= 1      
            if i >= k - 1:
                if a < sol:
                    sol = a    
        return sol
