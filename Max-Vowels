class Solution(object):
    def maxVowels(self, s, k):
        v = {'a':1,'e':1,'i':1,'o':1,'u':1}
        count = maxv = 0
        for i in range(len(s)):
            if s[i] in v:
                count += 1
            if i >= k and s[i-k] in v:
                count -= 1
            maxv = max(maxv, count)     
        return maxv
