class Solution(object):
    def generate(self, numRows):
        sol = []
        for i in range(numRows):
            a = [1]
            for j in range(1, i):
                a.append(sol[i - 1][j - 1] + sol[i - 1][j])
            if i > 0:
                a.append(1)
            sol.append(a)
        return sol
