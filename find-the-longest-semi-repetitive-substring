class Solution:
    def longestSemiRepetitiveSubstring(self, s: str) -> int:
        store = []
        l = 0
        length = 1
        for r in range(1, len(s)):
            if s[r] == s[r - 1]:
                store.append(r)
            if len(store) > 1:
                l = store[-2]  
            length = max(length, r - l + 1)
        return length
