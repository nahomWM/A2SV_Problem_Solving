class Solution(object):
    def findRelativeRanks(self, score):
        original = score[:]   
        solution = []       
        score.sort(reverse=True)       
        for i in original:
            rank = score.index(i)           
            if rank == 0:
                solution.append("Gold Medal")
            elif rank == 1:
                solution.append("Silver Medal")
            elif rank == 2:
                solution.append("Bronze Medal")
            else:
                solution.append(str(rank + 1))          
        return solution
