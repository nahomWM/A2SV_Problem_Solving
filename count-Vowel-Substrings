class Solution:
    def countVowelSubstrings(self, word):
        v = "aeiou"
        sol = 0
        for i in range(len(word)):
            d = {}
            for j in range(i, len(word)):
                if word[j] not in v:
                    break
                d[word[j]] = 1
                if len(d) == 5: 
                    sol += 1
        return sol
