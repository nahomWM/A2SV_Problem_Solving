class Solution(object):
    def twoSum(self, numbers, target):
        left = 0
        right = len(numbers) - 1      
        while left < right:
            sum_main = numbers[left] + numbers[right]            
            if sum_main == target:
                return [left + 1, right + 1]               
            elif sum_main < target:
                left += 1             
            else:
                right -= 1  
